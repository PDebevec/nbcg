log/

# ---------------------------------------------------------------------------
# Generated by the setup steps. Everything below is produced from a *.template
# / *.conf.* file plus the root .env, so it is reproducible — and some of it is
# secret material that must never be committed.
# ---------------------------------------------------------------------------

# Private keys and the CA. Committing these would publish the trust root the
# whole production stack chains to.
docker/certs/

# Rendered from templates by the applyConf / osSecurity steps
docker/nginx/nginx.conf
docker/nginx/htpasswd
docker/opensearch/opensearch.yml
docker/opensearch/.generated.json
docker/keycloak/nbcg-realm.json
docker/pgadmin/servers.json

# Generated production credentials — never commit.
.secrets.prod.json
