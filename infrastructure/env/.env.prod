# In prod every app runs inside the compose network, so services are reached by
# service name rather than through published ports.
POSTGRES_HOSTNAME="db"
REDIS_HOSTNAME="redis"
KEYCLOAK_HOSTNAME="keycloak"
OPENSEARCH_HOSTNAME="opensearch-node"
SEAWEEDFS_MASTER_HOSTNAME="master"
SEAWEEDFS_VOLUME_HOSTNAME="volume"

# nginx terminates TLS and proxies to Keycloak over plain HTTP inside the
# network, so Keycloak has no certificate of its own. KEYCLOAK_URL is therefore
# the PUBLIC url, derived by the "config" step as
# https://<first available_hostname><KEYCLOAK_BASE_PATH>. Put your real domain
# first in master.config.json's available_hostnames.
#
# The path nginx serves Keycloak under. Must match KC_HTTP_RELATIVE_PATH in
# docker-compose.prod.yml and the /auth/ location in nginx.conf.template.
KEYCLOAK_BASE_PATH=/auth

# Uncomment to pin the public Keycloak URL by hand instead of deriving it:
# KEYCLOAK_URL=

# The SPA is served as static files by the frontend container's nginx on 80,
# behind the edge nginx — there is no Quasar server in prod. This value is only
# used to build dev origins, so it is inert here.
FRONTEND_PORT=443

NODE_ENV=production

# CORS_ORIGIN is derived by the "config" step from master.config.json's
# available_hostnames (https://<host>, no port — nginx terminates TLS).
# In prod the SPA and the API share one origin, so CORS is belt-and-braces
# rather than load-bearing. Put your real public domain in available_hostnames.

# ---------------------------------------------------------------------------
# Backups (infrastructure/scripts/backup.sh, `make cron-backup`)
# Both must be set before a backup will run.
# ---------------------------------------------------------------------------
# Absolute path to the restic repository, e.g. /srv/backups/nbcg
RESTIC_REPO=
RESTIC_PASSWORD=
