POSTGRES_USER=nbcg
POSTGRES_DB=nbcg

KEYCLOAK_POSTGRES_USER=nbcg
KEYCLOAK_POSTGRES_DB=nbcg

KEYCLOAK_ADMIN=nbcg
KEYCLOAK_REALM=nbcg
KEYCLOAK_CLIENT_ID=nbcg-api

PGADMIN_DEFAULT_EMAIL=admin@nbcg.me

# app ports (backend listens here; frontend port differs per environment)
BACKEND_PORT=3000

# External COBISS API token. No default in code — the backend interpolates it
# straight into a request URL, so leaving it empty makes those calls fail.
COBISS_TOKEN=

# Apache Tika endpoint. The tika service was removed from the compose files but
# backend/src/core/tika/tika.service.ts still reads this — set it if you run
# Tika yourself, otherwise text extraction is unavailable.
TIKA_HOST=