# metadata db
POSTGRES_PASSWORD=nbcg

# Keycloak DB
KEYCLOAK_POSTGRES_PASSWORD=nbcg

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=nbcg
KEYCLOAK_WORKER_CLIENT_SECRET=nbcg

# Realm hardening that belongs in prod, not on a laptop:
#  - sslRequired "external" makes Keycloak reject plain HTTP from any host it
#    doesn't consider local — which is why login worked over localhost:8082
#    but silently failed over the LAN IP:8082 the stack is otherwise pinned
#    to (dev never terminates TLS in front of Keycloak — KC_HTTP_ENABLED,
#    docker-compose.dev.yml). "none" matches that reality.
#  - bruteForceProtected temporarily locks an account after repeated bad
#    logins — real protection in prod, just friction while poking at auth
#    locally.
#  - passwordPolicy (12 chars, mixed case, digit, special, history(3)) makes
#    every other secret in this file — literally "nbcg" — unusable as a test
#    user's password. Empty means "no policy".
KEYCLOAK_SSL_REQUIRED=none
KEYCLOAK_BRUTE_FORCE_PROTECTED=false
KEYCLOAK_PASSWORD_POLICY=

# The URL a BROWSER uses to reach Keycloak. It is also the token issuer, so the
# backend must use the same value — pointing them at different hosts makes
# otherwise-valid tokens fail validation.
#
# Derived by the "config" step as http://<first available_hostname>:<keycloak
# external port>, so browsing from another machine only needs that host added
# to master.config.json's available_hostnames — first in the list, since the
# first entry is the canonical one. Uncomment to pin it by hand instead.
# KEYCLOAK_URL=http://localhost:8082

# Only meaningful in prod, where Keycloak is reverse-proxied under a subpath.
# In dev Keycloak is published directly on its own port (no subpath, no
# shared origin with the frontend), so this stays empty — declared here only
# so env_routing's ${KEYCLOAK_BASE_PATH} substitution resolves to "" instead
# of leaking the literal, unresolved "${KEYCLOAK_BASE_PATH}" into frontend/.env.
KEYCLOAK_BASE_PATH=

# pgadmin
PGADMIN_DEFAULT_PASSWORD=nbcg

# opensearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=VelikiPassword1!

# backend and frontend
# In dev both apps run on the host, so every service is reached through its
# published port on localhost.
POSTGRES_HOSTNAME="localhost"
REDIS_HOSTNAME="localhost"
OPENSEARCH_HOSTNAME="localhost"
SEAWEEDFS_MASTER_HOSTNAME="localhost"
SEAWEEDFS_VOLUME_HOSTNAME="localhost"

# Quasar dev server (frontend/quasar.config.ts devServer.port)
FRONTEND_PORT=3080
# CORS_ORIGIN is derived by the "config" step from master.config.json's
# available_hostnames + FRONTEND_PORT — set it there, not here.

NODE_ENV=development