# metadata db
POSTGRES_PASSWORD=nbcg

# Keycloak DB
KEYCLOAK_POSTGRES_PASSWORD=nbcg

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=nbcg
KEYCLOAK_URL=http://localhost:8082
# Must match `nbcg-worker`'s secret in nbcg-realm.conf.json. Keycloak masks
# secrets on export, so that file pins an explicit literal — a realm re-import
# has to reproduce a secret the backend already knows.
KEYCLOAK_WORKER_CLIENT_SECRET=CHANGE_ME_worker_secret

# pgadmin
PGADMIN_DEFAULT_PASSWORD=nbcg

# opensearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=VelikiPassword1!

# backend and frontend
HOSTNAME="localhost"
POSTGRES_HOSTNAME="localhost"
REDIS_HOSTNAME="localhost"
OPENSEARCH_HOSTNAME="localhost"

TIKA_HOST=http://localhost:9998