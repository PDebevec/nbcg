[
  {
    "database": "nbcg",
    "index": "records",
    "setting": {
      "analysis": {
        "filter": {
          "folding": { "type": "asciifolding", "preserve_original": true }
        },
        "char_filter": {
          "identifier_separators": { "type": "pattern_replace", "pattern": "[\\s\\p{Pd}]", "replacement": "" }
        },
        "normalizer": {
          "identifier": { "type": "custom", "char_filter": ["identifier_separators"], "filter": ["lowercase"] }
        },
        "tokenizer": {
          "four_digit_years": { "type": "pattern", "pattern": "(?<!\\d)\\d{4}(?!\\d)", "group": 0 }
        },
        "analyzer": {
          "default": { "type": "custom", "tokenizer": "standard", "filter": ["lowercase", "folding"] },
          "years": { "type": "custom", "tokenizer": "four_digit_years" }
        }
      }
    },
    "nodes": {
      "table": "records",
      "columns": [
        "id",
        "visibilityStatus",
        "metadata",
        "version",
        "createdAt",
        "updatedAt",
        "createdByUserId",
        "createdByName",
        "updatedByUserId",
        "updatedByName"
      ],
      "transform": {
        "mapping": {
          "id": { "type": "keyword" },
          "visibilityStatus": { "type": "keyword" },
          "metadata": {
            "type": "object",
            "enabled": true,
            "properties": {
              "issue": { "properties": { "date": { "type": "keyword" } } },
              "isbn": {
                "type": "text",
                "fields": {
                  "keyword": { "type": "keyword", "ignore_above": 256 },
                  "normalized": { "type": "keyword", "normalizer": "identifier" }
                }
              },
              "issn": {
                "type": "text",
                "fields": {
                  "keyword": { "type": "keyword", "ignore_above": 256 },
                  "normalized": { "type": "keyword", "normalizer": "identifier" }
                }
              },
              "publication": {
                "properties": {
                  "year": {
                    "type": "text",
                    "fields": {
                      "keyword": { "type": "keyword", "ignore_above": 256 },
                      "years": { "type": "text", "analyzer": "years" }
                    }
                  }
                }
              }
            }
          },
          "version": { "type": "integer" },
          "createdAt": { "type": "date" },
          "updatedAt": { "type": "date" },
          "createdByUserId": { "type": "keyword" },
          "createdByName": { "type": "keyword" },
          "updatedByUserId": { "type": "keyword" },
          "updatedByName": { "type": "keyword" },
          "file_attachments": {
            "type": "nested",
            "properties": {
              "id": { "type": "keyword" },
              "fileType": { "type": "keyword" },
              "role": { "type": "keyword" },
              "filename": { "type": "text" },
              "mimeType": { "type": "keyword" },
              "sizeBytes": { "type": "long" },
              "textExtractionStatus": { "type": "keyword" },
              "extractedText": { "type": "text" },
              "createdAt": { "type": "date" }
            }
          }
        }
      },
      "children": [
        {
          "table": "file_attachments",
          "columns": [
            "id",
            "fileType",
            "role",
            "filename",
            "mimeType",
            "sizeBytes",
            "textExtractionStatus",
            "extractedText",
            "createdAt"
          ],
          "relationship": {
            "variant": "object",
            "type": "one_to_many",
            "foreign_key": {
              "child": ["record_id"],
              "parent": ["id"]
            }
          }
        },
        {
          "table": "item_relations",
          "label": "parent_relations",
          "columns": [
            "parentId",
            "parentType"
          ],
          "transform": {
            "mapping": {
              "parentId": { "type": "keyword" },
              "parentType": { "type": "keyword" }
            }
          },
          "relationship": {
            "variant": "object",
            "type": "one_to_many",
            "foreign_key": {
              "child": ["childId"],
              "parent": ["id"]
            }
          }
        }
      ]
    }
  },
