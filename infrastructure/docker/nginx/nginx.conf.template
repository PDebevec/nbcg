# =============================================================================
# GENERATED by the "applyConf" step from nginx.conf.template.
# Edit the template, not this file — and put hostnames in master.config.json.
#
# Dollar-paren placeholders are substituted from the root .env. nginx's own
# $variables ($host, $remote_addr, …) are left alone — the renderer only
# touches the parenthesised form, never the bare one.
#
# Topology: this is the only thing exposed to the network. It terminates TLS
# and routes by path on one origin, which is what the application already
# assumes — frontend/src/boot/axios.ts uses a relative baseURL of '/api', and
# the router is in hash mode. Same origin also means CORS never comes into it.
# =============================================================================

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile      on;
    tcp_nopush    on;
    server_tokens off;

    # The backend accepts uploads up to 2 GB (files.controller.ts). nginx
    # defaults to 1 MB, which would reject them at the proxy with a 413 that
    # never reaches the application.
    client_max_body_size 2g;
    # Stream large bodies straight through instead of spooling them to disk
    # first — SeaweedFS transfers are multi-GB.
    proxy_request_buffering off;
    proxy_read_timeout  3600s;
    proxy_send_timeout  3600s;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/xml text/xml image/svg+xml;
    gzip_min_length 1024;

    # ---------------------------------------------------------------------
    # HTTP: redirect everything to HTTPS.
    # ---------------------------------------------------------------------
    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # ---------------------------------------------------------------------
    # HTTPS
    # ---------------------------------------------------------------------
    server {
        listen 443 ssl default_server;
        http2 on;
        server_name $(ALLOWED_HOSTNAMES_SPACED);

        ssl_certificate     /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 1d;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

        # Shared by every proxied location. Keycloak needs these to build
        # correct absolute URLs — it is configured with KC_PROXY_HEADERS
        # xforwarded and trusts nothing else.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_http_version 1.1;

        # Docker's embedded DNS. Without a resolver, nginx resolves every
        # upstream name once at startup: it refuses to start at all if one is
        # not up yet, and it keeps the old address after a container is
        # recreated with a new one. Putting the upstream in a variable is what
        # defers resolution to request time.
        resolver 127.0.0.11 valid=10s ipv6=off;

        # -----------------------------------------------------------------
        # API. The /api prefix is NOT stripped: the backend sets
        # setGlobalPrefix('api'), so it expects to see it.
        # -----------------------------------------------------------------
        location /api/ {
            set $upstream_backend http://backend:$(BACKEND_PORT_INTERNAL);
            proxy_pass $upstream_backend;
        }

        # -----------------------------------------------------------------
        # Keycloak. It serves itself under this path (KC_HTTP_RELATIVE_PATH),
        # so there is nothing to rewrite here either.
        # -----------------------------------------------------------------
        location /auth/ {
            set $upstream_keycloak http://keycloak:$(KEYCLOAK_PORT_INTERNAL);
            proxy_pass $upstream_keycloak;
            # Keycloak sends large headers after a login round-trip
            proxy_buffer_size   8k;
            proxy_buffers       8 8k;
            proxy_busy_buffers_size 16k;
        }

        # -----------------------------------------------------------------
        # PROVISIONAL — admin UIs.
        #
        # Both pgAdmin and OpenSearch Dashboards need their own configuration
        # to be served correctly under a subpath (X-Script-Name for pgAdmin,
        # server.basePath for Dashboards). This gets them reachable behind
        # authentication over TLS instead of published on the host, which is
        # the security-relevant part; making the subpaths behave properly is
        # the deferred piece.
        # -----------------------------------------------------------------
        # pgAdmin wants the prefix REMOVED and rebuilds its own URLs from
        # X-Script-Name, so this one strips it — hence the regex capture, which
        # is how a prefix is stripped when the upstream is in a variable.
        location ~ ^/pgadmin/(.*)$ {
            auth_basic           "Restricted";
            auth_basic_user_file /etc/nginx/htpasswd;
            # A location that sets ANY proxy_set_header stops inheriting the
            # server block's — it doesn't merge — so everything above has to
            # be repeated here too, or pgAdmin (told to trust one hop of
            # forwarded headers via PGADMIN_CONFIG_PROXY_X_PREFIX_COUNT) gets
            # none of them.
            proxy_set_header     Host              $host;
            proxy_set_header     X-Real-IP         $remote_addr;
            proxy_set_header     X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header     X-Forwarded-Proto $scheme;
            proxy_set_header     X-Forwarded-Host  $host;
            proxy_set_header     X-Forwarded-Port  $server_port;
            proxy_set_header     X-Script-Name     /pgadmin;
            set $upstream_pgadmin http://pgadmin:$(PGADMIN_PORT_INTERNAL);
            proxy_pass $upstream_pgadmin/$1$is_args$args;
        }

        # Dashboards is configured with SERVER_BASEPATH=/dashboards, so it
        # expects to SEE the prefix — the opposite of pgAdmin.
        location /dashboards/ {
            auth_basic           "Restricted";
            auth_basic_user_file /etc/nginx/htpasswd;
            set $upstream_dashboards http://opensearch-dashboards:$(OPENSEARCH_DASHBOARDS_INTERNAL);
            proxy_pass $upstream_dashboards;
        }

        # -----------------------------------------------------------------
        # The SPA, served by the frontend container's own nginx on port 80.
        # -----------------------------------------------------------------
        location / {
            set $upstream_frontend http://frontend:80;
            proxy_pass $upstream_frontend;
        }
    }
}
